{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/rj-nexus/rj_cms_theme_and_plugin_list/main/schema/registry.schema.json",
  "title": "RJ Nexus Registry Index",
  "type": "object",
  "required": ["version", "updated_at", "themes", "plugins"],
  "additionalProperties": false,
  "properties": {
    "$schema": { "type": "string", "format": "uri" },
    "version": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+(\\.\\d+)?$",
      "description": "Registry schema version."
    },
    "updated_at": {
      "type": "string",
      "format": "date-time",
      "description": "ISO 8601 timestamp of the last registry change."
    },
    "themes": { "$ref": "#/$defs/section" },
    "plugins": { "$ref": "#/$defs/section" }
  },
  "$defs": {
    "section": {
      "type": "object",
      "required": ["url", "count", "updated_at"],
      "additionalProperties": false,
      "properties": {
        "url": {
          "type": "string",
          "format": "uri",
          "description": "Raw URL of the section file."
        },
        "count": {
          "type": "integer",
          "minimum": 0
        },
        "updated_at": {
          "type": "string",
          "format": "date-time"
        }
      }
    }
  }
}
