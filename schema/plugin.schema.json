{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/rj-nexus/rj_cms_theme_and_plugin_list/main/schema/plugin.schema.json",
  "title": "RJ Nexus Plugins List",
  "type": "object",
  "required": ["plugins"],
  "additionalProperties": false,
  "properties": {
    "$schema": { "type": "string", "format": "uri" },
    "plugins": {
      "type": "array",
      "minItems": 0,
      "items": { "$ref": "#/$defs/plugin" }
    }
  },
  "$defs": {
    "plugin": {
      "type": "object",
      "required": ["repo", "name", "author", "version", "verified", "featured", "category", "tags", "logo", "screenshots", "details", "installation", "development"],
      "additionalProperties": false,
      "properties": {
        "repo": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$",
          "description": "GitHub repository in owner/repo format."
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80
        },
        "author": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80
        },
        "version": {
          "type": "string",
          "pattern": "^\\d+\\.\\d+\\.\\d+(-[A-Za-z0-9.-]+)?$"
        },
        "verified": { "type": "boolean" },
        "featured": { "type": "boolean" },
        "category": {
          "type": "string",
          "enum": ["general", "ecommerce", "forms", "seo", "marketing", "analytics", "security", "media", "social", "developer", "other"]
        },
        "tags": {
          "type": "array",
          "maxItems": 8,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 24,
            "pattern": "^[a-z0-9-]+$"
          }
        },
        "logo": {
          "type": "string",
          "format": "uri",
          "description": "Direct URL to the plugin logo image. Empty string allowed."
        },
        "screenshots": {
          "type": "array",
          "maxItems": 8,
          "items": { "type": "string", "format": "uri" }
        },
        "details": { "$ref": "#/$defs/details" },
        "installation": { "$ref": "#/$defs/installation" },
        "development": { "$ref": "#/$defs/development" }
      }
    },
    "details": {
      "type": "object",
      "required": ["description", "features"],
      "additionalProperties": false,
      "properties": {
        "description": {
          "type": "string",
          "minLength": 1,
          "maxLength": 500
        },
        "features": {
          "type": "array",
          "maxItems": 12,
          "items": { "type": "string", "minLength": 1, "maxLength": 120 }
        }
      }
    },
    "installation": {
      "type": "object",
      "required": ["steps"],
      "additionalProperties": false,
      "properties": {
        "steps": {
          "type": "array",
          "minItems": 1,
          "maxItems": 15,
          "items": { "type": "string", "minLength": 1, "maxLength": 200 }
        }
      }
    },
    "development": {
      "type": "object",
      "required": ["requires", "docs"],
      "additionalProperties": false,
      "properties": {
        "requires": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120
        },
        "docs": {
          "type": "string",
          "format": "uri"
        }
      }
    }
  }
}
